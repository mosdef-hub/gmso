<?xml version="1.0" encoding="UTF-8"?>
<!--
  Both atom types are Lennard-Jones, but the _A-_B pair is given Buckingham
  parameters. That pairtype owns the pair, so it must not also be mixed.
-->
<ForceField version="0.0.1" name="CrossExpressionPair">
  <FFMetaData combiningRule="lorentz">
    <Units energy="kJ/mol" distance="nm" mass="amu" charge="coulomb"/>
  </FFMetaData>

  <AtomTypes expression="4*epsilon*((sigma/r)**12 - (sigma/r)**6)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <AtomType name="_A" element="_A" atomclass="_A" mass="1.0" charge="0.0" definition="_A" description="LJ bead A">
      <Parameters>
        <Parameter name="sigma" value="0.30"/>
        <Parameter name="epsilon" value="0.40"/>
      </Parameters>
    </AtomType>
    <AtomType name="_B" element="_B" atomclass="_B" mass="1.0" charge="0.0" definition="_B" description="LJ bead B">
      <Parameters>
        <Parameter name="sigma" value="0.40"/>
        <Parameter name="epsilon" value="0.90"/>
      </Parameters>
    </AtomType>
  </AtomTypes>

  <PairPotentialTypes expression="A*exp(-r/rho) - C/r**6">
    <ParametersUnitDef parameter="A" unit="kJ/mol"/>
    <ParametersUnitDef parameter="rho" unit="nm"/>
    <ParametersUnitDef parameter="C" unit="kJ/mol*nm**6"/>
    <PairPotentialType name="HOOMDBuckinghamPotential" type1="_A" type2="_B">
      <Parameters>
        <Parameter name="A" value="300.0"/>
        <Parameter name="rho" value="0.050"/>
        <Parameter name="C" value="0.003"/>
      </Parameters>
    </PairPotentialType>
  </PairPotentialTypes>
</ForceField>
