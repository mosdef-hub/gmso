<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mie beads that disagree on the n exponent. Exponents have no combining rule
  here, so the _A-_B pair is stated explicitly in PairPotentialTypes. Removing
  that pair type leaves the cross pair with no way to be built.
-->
<ForceField version="0.0.1" name="MieMismatch">
  <FFMetaData combiningRule="lorentz">
    <Units energy="kJ/mol" distance="nm" mass="amu" charge="coulomb"/>
  </FFMetaData>

  <AtomTypes expression="(n/(n-m)) * (n/m)**(m/(n-m)) * epsilon * ((sigma/r)**n - (sigma/r)**m)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <ParametersUnitDef parameter="n" unit="dimensionless"/>
    <ParametersUnitDef parameter="m" unit="dimensionless"/>
    <AtomType name="_A" element="_A" atomclass="_A" mass="1.0" charge="0.0" definition="_A" description="Mie bead A">
      <Parameters>
        <Parameter name="sigma" value="0.30"/>
        <Parameter name="epsilon" value="0.40"/>
        <Parameter name="n" value="12"/>
        <Parameter name="m" value="6"/>
      </Parameters>
    </AtomType>
    <AtomType name="_B" element="_B" atomclass="_B" mass="1.0" charge="0.0" definition="_B" description="Mie bead B">
      <Parameters>
        <Parameter name="sigma" value="0.40"/>
        <Parameter name="epsilon" value="0.90"/>
        <Parameter name="n" value="14"/>
        <Parameter name="m" value="6"/>
      </Parameters>
    </AtomType>
  </AtomTypes>

  <PairPotentialTypes expression="(n/(n-m)) * (n/m)**(m/(n-m)) * epsilon * ((sigma/r)**n - (sigma/r)**m)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <ParametersUnitDef parameter="n" unit="dimensionless"/>
    <ParametersUnitDef parameter="m" unit="dimensionless"/>
    <PairPotentialType name="MiePotential" type1="_A" type2="_B">
      <Parameters>
        <Parameter name="sigma" value="2.22222"/>
        <Parameter name="epsilon" value="9.11111"/>
        <Parameter name="n" value="13"/>
        <Parameter name="m" value="6"/>
      </Parameters>
    </PairPotentialType>
  </PairPotentialTypes>
</ForceField>
