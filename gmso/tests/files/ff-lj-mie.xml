<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two sigma/epsilon nonbonded expressions in one force field: _A is
  Lennard-Jones 12-6, _M is Mie. The _A-_M pair belongs to neither atom type
  group, so it is given Lennard-Jones parameters explicitly.
-->
<ForceField version="0.0.1" name="LJMie">
  <FFMetaData combiningRule="lorentz">
    <Units energy="kJ/mol" distance="nm" mass="amu" charge="coulomb"/>
  </FFMetaData>

  <AtomTypes expression="4*epsilon*((sigma/r)**12 - (sigma/r)**6)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <AtomType name="_A" element="_A" atomclass="_A" mass="1.0" charge="0.0" definition="_A" description="LJ bead">
      <Parameters>
        <Parameter name="sigma" value="0.30"/>
        <Parameter name="epsilon" value="0.40"/>
      </Parameters>
    </AtomType>
  </AtomTypes>

  <AtomTypes expression="(n/(n-m)) * (n/m)**(m/(n-m)) * epsilon * ((sigma/r)**n - (sigma/r)**m)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <ParametersUnitDef parameter="n" unit="dimensionless"/>
    <ParametersUnitDef parameter="m" unit="dimensionless"/>
    <AtomType name="_M" element="_M" atomclass="_M" mass="1.0" charge="0.0" definition="_M" description="Mie bead">
      <Parameters>
        <Parameter name="sigma" value="0.45"/>
        <Parameter name="epsilon" value="0.90"/>
        <Parameter name="n" value="14"/>
        <Parameter name="m" value="6"/>
      </Parameters>
    </AtomType>
  </AtomTypes>

  <PairPotentialTypes expression="4*epsilon*((sigma/r)**12 - (sigma/r)**6)">
    <ParametersUnitDef parameter="sigma" unit="nm"/>
    <ParametersUnitDef parameter="epsilon" unit="kJ/mol"/>
    <PairPotentialType name="LennardJonesPotential" type1="_A" type2="_M">
      <Parameters>
        <Parameter name="sigma" value="0.375"/>
        <Parameter name="epsilon" value="0.60"/>
      </Parameters>
    </PairPotentialType>
  </PairPotentialTypes>
</ForceField>
